# ==========================================
# EVOLUTION API
# ==========================================
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://api:8080

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution_user:evolution_password@evolution-postgres:5432/evolution_api?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution

EVO_POSTGRES_DB=evolution_api
EVO_POSTGRES_USER=evolution_user
EVO_POSTGRES_PASSWORD=evolution_password

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379
CACHE_REDIS_PREFIX_KEY=evolution-cache
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=true

AUTHENTICATION_API_KEY=CHANGE_ME_NOW

CORS_ORIGIN=*
CORS_METHODS=POST,GET,PUT,DELETE
CORS_CREDENTIALS=true

LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE,DARK,WEBHOOKS,WEBSOCKET
LOG_COLOR=true
LOG_BAILEYS=error

WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=true

TYPEBOT_ENABLED=true
TYPEBOT_API_VERSION=old
TYPEBOT_SEND_MEDIA_BASE64=false

CHATWOOT_ENABLED=true
CHATWOOT_MESSAGE_DELETE=true
CHATWOOT_MESSAGE_READ=true
CHATWOOT_BOT_CONTACT=true
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=postgresql://chatwoot:chatwoot@chatwoot-postgres:5432/chatwoot_production?schema=public
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=false

OPENAI_ENABLED=true
OPENAI_API_KEY_GLOBAL=CHANGE_ME_NOW

DIFY_ENABLED=true
N8N_ENABLED=true
EVOAI_ENABLED=true
FLOWISE_ENABLED=true

# ==========================================
# EVOLUTION MANAGER
# ==========================================
VITE_EVOLUTION_API_URL=http://localhost:8080
VITE_EVOLUTION_API_KEY=CHANGE_ME_NOW

# ==========================================
# N8N
# ==========================================
N8N_HOST=n8n.local
# N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://n8n.local:5678
# N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://n8n.local:5678
# WEBHOOK_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/Sao_Paulo

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=n8n-postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n

N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=n8n

N8N_ENCRYPTION_KEY=change-me-with-a-random-secret
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
